class DataRetriever:

    def __init__(self, input_data:InputData):

        if not input_data.inference:
            self.reference = input_data.target
            self.variables = [input_data.var1, input_data.var2, input_data.var3]
        else:

            self.reference=input_data.var1
            self.variables = [input_data.var2, input_data.var3]

        self.start_date = input_data.start_date
        self.end_date = input_data.end_date


    def retrieve_series(self, index, start_date, end_date):
        name, ticker = index.split('/')
        df = yf.Ticker(ticker).history(start=start_date, end=end_date)

        if df.index.dtype=='datetime64[s, Asia/Seoul]':
            s = df['Open']
        else:
            s = df['Close']

        s = s.rename(name)
        s.index = s.index.date
        return s


    def create_aligned_dataset(self):

        reference_series = self.retrieve_series(
                                index=self.reference,
                                start_date=self.start_date,
                                end_date=self.end_date)

        df = pd.DataFrame(reference_series)

        for var in self.variables:
            df = df.join(self.retrieve_series(
                                    index=var,
                                    start_date=self.start_date,
                                    end_date=self.end_date),
                                    how='left')

        df = df.ffill()
        features = df.columns[1:]
        df[features] = df[features].shift(1)

        return df


    def log_return(self):
        df = self.create_aligned_dataset()
        df_log_return = np.log(df/df.shift(1))
        final_df = df_log_return.dropna()

        return final_df
