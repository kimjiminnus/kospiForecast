class Pipeline:
    def __init__(self, task, df, plot_loss):
        # DEFAULT CONFIGURATIONS
        self.task = task
        self.model_config = ModelConfig()
        self.train_args = TrainingArguments()
        self.df = df
        self.optimiser = optim.Adam

        self.trainer = Trainer(df=self.df,
                               model_config=self.model_config,
                               train_args=self.train_args,
                               optimiser=self.optimiser)
        self.plot_loss = plot_loss


    def __call__(self):
        if self.task == 'train':
            self.trainer.train(self.plot_loss)
        elif self.task == 'evaluate':
            self.trainer.evaluate(self.plot_loss)
        elif self.task == 'train_evaluate':
            self.trainer.train_evaluate(self.plot_loss)
