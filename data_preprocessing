class TimeSeriesDataset(Dataset):
    def __init__(self, df, window):
        self.df = df
        self.x = torch.tensor(df.iloc[:, 1:].values, dtype=torch.float32)
        self.y = torch.tensor(df.iloc[:, [0]].values, dtype=torch.float32)
        self.window = window
        self.num_windows = len(df) - window + 1

    def __len__(self):
        return self.num_windows

    def __getitem__(self, idx):
        start_idx = idx
        end_idx = idx + self.window

        return self.x[start_idx:end_idx, :], self.y[start_idx:end_idx, :]



def split_datasets_and_dataloaders(df, window, batch_size):
    train_df, test_df = train_test_split(df, test_size=0.2, random_state=42, shuffle=False)

    train_dataset = TimeSeriesDataset(train_df, window)
    val_dataset = TimeSeriesDataset(test_df, window)

    train_loader = DataLoader(train_dataset, batch_size=batch_size, shuffle=True)
    val_loader = DataLoader(val_dataset, batch_size=batch_size, shuffle=False)

    return train_dataset, val_dataset, train_loader, val_loader
