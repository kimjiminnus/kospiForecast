class DataPipeline:
    def __init__(self, input_data:InputData, train_args:TrainingArguments, model_config:ModelConfig):
        self.preprocessor = DataPreprocessor(input_data)
        self.test_split = input_data.test_split
        self.train_args = train_args
        self.model_config = model_config

    def train_test_split(self, df):
        train_df, test_df = train_test_split(df,
                                             test_size=self.test_split,
                                             random_state=42,
                                             shuffle=False)
        return train_df, test_df


    def create_dataloaders(self, train_df, test_df):
        train_dataset = TimeSeriesDataset(train_df, self.model_config.max_window)
        test_dataset = TimeSeriesDataset(test_df, self.model_config.max_window)

        train_loader = DataLoader(train_dataset, batch_size=self.train_args.train_batch_size, shuffle=True)
        test_loader = DataLoader(test_dataset, batch_size=self.train_args.eval_batch_size, shuffle=False)

        return train_loader, test_loader

    def run(self):
        df = self.preprocessor.retrieve_data()

        df = self.preprocessor.pre_split_preprocess(df)
        train_df, test_df = self.train_test_split(df)
        train_df, test_df = self.preprocessor.post_split_scaling(train_df, test_df)

        train_loader, test_loader = self.create_dataloaders(train_df, test_df)

        return train_loader, test_loader
