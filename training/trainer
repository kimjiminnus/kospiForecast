class Trainer:
    def __init__(self, data_pipeline:DataPipeline, model, train_args:TrainingArguments, optimiser):

        self.device = torch.device("cuda" if torch.cuda.is_available() else "mps")
        self.train_args = train_args
        self.model = model.to(self.device)

        self.train_loader, self.val_loader = data_pipeline.run()

        self.optimiser = optimiser(params=self.model.parameters(),
                                   lr=train_args.learning_rate,
                                   weight_decay=train_args.weight_decay)

        self.train_loss_list = []
        self.val_loss_list = []


    def train(self, plot_loss=False):
        for epoch in range(self.train_args.epochs):
            loss = train_loop(
                        model=self.model,
                        train_loader=self.train_loader,
                        criterion=self.train_args.criterion,
                        optimiser=self.optimiser,
                        device=self.device)
            self.train_loss_list.append(loss)

        if plot_loss:
            plot_losses(train_losses=self.train_loss_list,
                        val_losses=None)

        return self.train_loss_list


    def evaluate(self, plot_loss=False):
        loss = eval_loop(
                    model=self.model,
                    val_loader=self.val_loader,
                    criterion=self.train_args.criterion,
                    device=self.device)
        self.val_loss_list.append(loss)

        if plot_loss:
            plot_losses(train_losses=None,
                        val_losses=self.val_loss_list)
        return self.val_loss_list


    def train_evaluate(self, plot_loss=False):
        model, ave_train_losses, ave_val_losses = train_and_evaluate(
                           epochs=self.train_args.epochs,
                           model=self.model,
                           train_loader=self.train_loader,
                           val_loader=self.val_loader,
                           criterion=self.train_args.criterion,
                           optimiser=self.optimiser,
                           device=self.device,
                           plot_loss=plot_loss
                           )
        return ave_train_losses, ave_val_losses

